APP_NAME=MbunieEduHub
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql

# ===== LOCAL (WAMP) =====
LOCAL_DB_HOST=127.0.0.1
LOCAL_DB_PORT=3306
LOCAL_DB_DATABASE=laravel
LOCAL_DB_USERNAME=root
LOCAL_DB_PASSWORD=

# ===== PRODUCTION (HOSTINGER) =====
HOSTINGER_DB_HOST=127.0.0.1
HOSTINGER_DB_PORT=3306
HOSTINGER_DB_DATABASE=your_hostinger_db
HOSTINGER_DB_USERNAME=your_hostinger_user
HOSTINGER_DB_PASSWORD=your-hostinger-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Live classroom: our own self-hosted video stack (deploy/live-server/README.md) ---
# Browser-facing SFU signalling address (wss:// in production; ws://127.0.0.1:7880 for local dev)
LIVE_SERVER_URL=
# Server API base URL (defaults to LIVE_SERVER_URL with ws→http)
LIVE_SERVER_API_URL=
# Same key/secret pair as the SFU (LIVEKIT_KEYS). Local dev server: devkey / secret
LIVE_SERVER_API_KEY=
LIVE_SERVER_API_SECRET=
LIVE_TOKEN_TTL_MINUTES=10
LIVE_MAX_PARTICIPANTS=100
# Our coturn server (comma-separated URLs)
STUN_SERVER_URLS=
TURN_SERVER_URL=
# Preferred: coturn static-auth-secret → expiring per-user credentials
TURN_SERVER_SECRET=
TURN_CREDENTIAL_TTL_MINUTES=720
# Fallback: fixed coturn user
TURN_SERVER_USERNAME=
TURN_SERVER_CREDENTIAL=
# all | relay (relay forces TURN — useful to test the firewall fallback)
LIVE_ICE_TRANSPORT_POLICY=all
# Server recording (LiveKit Egress on the live server)
LIVE_RECORDING_ENABLED=false
LIVE_EGRESS_OUTPUT_DIR=/out
LIVE_RECORDING_IMPORT_DIR=
LIVE_RECORDING_LAYOUT=speaker
