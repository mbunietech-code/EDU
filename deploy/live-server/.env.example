# Copy to .env on the live server (never commit the real file).

# Domains (both must have DNS A records pointing to PUBLIC_IP)
LIVE_DOMAIN=live.example.com
TURN_DOMAIN=turn.example.com
ACME_EMAIL=admin@example.com

# The server's public IPv4 address
PUBLIC_IP=203.0.113.10

# SFU API key pair — generate:  openssl rand -hex 8   (key, prefix "API")  and  openssl rand -base64 48   (secret)
# Put the SAME values in Laravel's .env as LIVE_SERVER_API_KEY / LIVE_SERVER_API_SECRET
# and the key in livekit.yaml → webhook.api_key.
LIVE_API_KEY=APIxxxxxxxxxxxxxxxx
LIVE_API_SECRET=change-me-to-at-least-32-random-characters

# coturn shared secret — generate: openssl rand -hex 32   (same value as Laravel's TURN_SERVER_SECRET)
TURN_SECRET=change-me

# Where Egress writes recordings on this host (Laravel's LIVE_RECORDING_IMPORT_DIR when Laravel runs here too)
RECORDINGS_DIR=/opt/live-server/recordings

# Image versions (pin to exact tags once a version is tested, e.g. v1.13.7)
LIVEKIT_VERSION=latest
EGRESS_VERSION=latest
COTURN_VERSION=latest
